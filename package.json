{
  "name": "ccua",
  "version": "0.1.0",
  "description": "Computer-use skill and async Node REPL that wraps Cua Driver with an @oai/sky-compatible API",
  "type": "module",
  "bin": {
    "ccua": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./sky": "./dist/sky.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "engines": {
    "node": ">=20",
    "bun": ">=1.1"
  },
  "scripts": {
    "build": "tsc",
    "test": "PATH=\"$HOME/.bun/bin:$PATH\" bun test",
    "ccua": "bun src/cli.ts",
    "prepare": "tsc"
  },
  "keywords": [
    "computer-use",
    "cua-driver",
    "sky",
    "repl",
    "skill",
    "accessibility"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
