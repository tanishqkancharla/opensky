{
  "name": "opensky",
  "version": "0.1.0",
  "description": "Open @oai/sky-compatible computer-use library and async REPL, backed by Cua Driver",
  "type": "module",
  "bin": {
    "opensky": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./opensky": "./dist/opensky.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "engines": {
    "node": ">=20",
    "bun": ">=1.1"
  },
  "scripts": {
    "build": "tsc",
    "test": "PATH=\"$HOME/.bun/bin:$PATH\" bun test",
    "opensky": "bun src/cli.ts",
    "prepare": "tsc"
  },
  "keywords": [
    "computer-use",
    "cua-driver",
    "opensky",
    "repl",
    "skill",
    "accessibility"
  ],
  "license": "MIT",
  "author": "Tanishq Kancharla",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanishqkancharla/opensky.git"
  },
  "homepage": "https://github.com/tanishqkancharla/opensky#readme",
  "bugs": {
    "url": "https://github.com/tanishqkancharla/opensky/issues"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
