{
  "name": "opensky-cua",
  "version": "0.1.2",
  "description": "Open computer-use library with legacy and native-style CUA APIs, backed by OpenSky Driver",
  "type": "module",
  "bin": {
    "opensky": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./opensky": "./dist/opensky.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "engines": {
    "node": ">=20",
    "bun": ">=1.1"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test --test-timeout=60000 test/*.test.ts",
    "evals": "node --import tsx evals/cli.ts",
    "eval:replay": "node --import tsx evals/replay.ts",
    "opensky": "node --import tsx src/cli.ts",
    "prepare": "tsc"
  },
  "keywords": [
    "computer-use",
    "cua-driver",
    "opensky",
    "repl",
    "skill",
    "accessibility"
  ],
  "license": "MIT",
  "author": "Tanishq Kancharla",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanishqkancharla/opensky.git"
  },
  "homepage": "https://github.com/tanishqkancharla/opensky#readme",
  "bugs": {
    "url": "https://github.com/tanishqkancharla/opensky/issues"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@types/bun": "^1.4.0",
    "@types/node": "^22.13.10",
    "tsx": "^4.23.13",
    "typebox": "^1.3.22",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "acorn": "^8.18.0"
  }
}
